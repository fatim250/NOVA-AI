<Application x:Class="WindowsNotchPro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Obsidian Liquid-Glass Palette -->
        <SolidColorBrush x:Key="ObsidianSurfaceBrush" Color="#F407090F" />
        <SolidColorBrush x:Key="RailSurfaceBrush" Color="#66000000" />
        <SolidColorBrush x:Key="BentoCardBrush" Color="#11FFFFFF" />
        <SolidColorBrush x:Key="BentoCardElevatedBrush" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="BentoBorderBrush" Color="#1EFFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7C8BA1" />
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentVioletBrush" Color="#A78BFA" />
        <SolidColorBrush x:Key="AccentEmeraldBrush" Color="#34D399" />
        <SolidColorBrush x:Key="AccentRoseBrush" Color="#FB7185" />
        <SolidColorBrush x:Key="AccentAmberBrush" Color="#FBBF24" />

        <LinearGradientBrush x:Key="SpecularShellBorder" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#44FFFFFF" Offset="0.0" />
            <GradientStop Color="#18FFFFFF" Offset="0.45" />
            <GradientStop Color="#0CFFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Bento Card Border Style -->
        <!-- Bento glass card: diagonal sheen fill + top-lit hairline border, brightens on hover -->
        <LinearGradientBrush x:Key="BentoCardGlassBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#17FFFFFF" Offset="0.0" />
            <GradientStop Color="#0CFFFFFF" Offset="0.55" />
            <GradientStop Color="#08FFFFFF" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BentoCardRimBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#30FFFFFF" Offset="0.0" />
            <GradientStop Color="#12FFFFFF" Offset="0.6" />
            <GradientStop Color="#0AFFFFFF" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BentoCardRimHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5538BDF8" Offset="0.0" />
            <GradientStop Color="#22A855F7" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BentoCardGlassHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1EFFFFFF" Offset="0.0" />
            <GradientStop Color="#10FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <Style x:Key="BentoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BentoCardGlassBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BentoCardRimBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BentoCardGlassHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BentoCardRimHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Section Micro-Header -->
        <Style x:Key="MicroLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- macOS Floating Segmented Icon Pill Tab Button -->
        <Style x:Key="MacSegmentedTabStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8E9BB0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16FFFFFF" />
                                <Setter Property="Foreground" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#40FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical Rail Navigation Button (kept for icon buttons) -->
        <Style x:Key="RailNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#7C8BA1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ActiveBar"
                                    Width="3"
                                    Height="18"
                                    CornerRadius="2"
                                    HorizontalAlignment="Left"
                                    Margin="-7,0,0,0"
                                    Background="#38BDF8"
                                    Opacity="0" />
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="12"
                                    BorderBrush="Transparent"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16FFFFFF" />
                                <Setter Property="Foreground" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="#2438BDF8" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4838BDF8" />
                                <Setter TargetName="ActiveBar" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Pill Action Button -->
        <Style x:Key="NotchPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#36FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="NotchAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource NotchPillButtonStyle}">
            <Setter Property="Background" Value="#3338BDF8" />
            <Setter Property="BorderBrush" Value="#6638BDF8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Compact Chip Button -->
        <Style x:Key="QuickChipButtonStyle" TargetType="Button" BasedOn="{StaticResource NotchPillButtonStyle}">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#19FFFFFF" />
        </Style>

        <!-- Circular Media / Icon Button -->
        <Style x:Key="CircleIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="#16FFFFFF" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Aurora Theme Dot -->
        <Style x:Key="AuroraDotButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Dot"
                                Width="8"
                                Height="8"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="11" />
                                <Setter TargetName="Dot" Property="Height" Value="11" />
                                <Setter TargetName="Dot" Property="CornerRadius" Value="5.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Sleek Dark Slider -->
        <Style x:Key="NotchSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5" CornerRadius="2.5" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="2.5,0,0,2.5" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FFFFFF"
                                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                                        BorderThickness="2"
                                                        CornerRadius="7">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.65" Color="#38BDF8" />
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom iOS-Style Dark Toggle Switch (CheckBox) -->
        <Style x:Key="NotchToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border x:Name="Track"
                                    Grid.Column="1"
                                    Width="34"
                                    Height="18"
                                    CornerRadius="9"
                                    Background="#26FFFFFF"
                                    BorderBrush="#22FFFFFF"
                                    BorderThickness="1">
                                <Border x:Name="Knob"
                                        Width="12"
                                        Height="12"
                                        CornerRadius="6"
                                        Background="#CBD5E1"
                                        HorizontalAlignment="Left"
                                        Margin="2,0,0,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#38BDF8" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#7DD3FC" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                                <Setter TargetName="Knob" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark Input TextBox -->
        <Style x:Key="NotchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#30000000" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="CaretBrush" Value="#38BDF8" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ComboBox -->
        <Style x:Key="NotchComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#30000000" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#30000000" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="9" Padding="9,5">
                                            <Grid>
                                                <Path Data="M0,0 L4,4 L8,0" Stroke="#94A3B8" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#F50D111A"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Padding="4">
                                    <ScrollViewer MaxHeight="160">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#E2E8F0" />
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2438BDF8" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3238BDF8" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim Translucent ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#2EFFFFFF" CornerRadius="2.5" Margin="0,2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
